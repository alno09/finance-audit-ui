!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
